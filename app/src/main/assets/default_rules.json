{
  "version": 0,
  "rules": {
    "nls": {
      "payment_signal_regex": "[¥￥]|RMB|CNY|人民币|支付|付款|到账|转账|消费|扣款|充值|退款|入账|收入|支出",
      "wechat": {
        "package_name": "com.tencent.mm",
        "direct_pass_titles": ["微信支付", "微信支付凭证"],
        "direct_pass_title_contains": ["零钱"],
        "message_prefixes": ["[转账]", "[微信红包]"],
        "amount_symbols": ["¥", "￥"]
      },
      "alipay": {
        "package_name": "com.eg.android.AlipayGphone",
        "allowed_title_keywords": ["交易提醒", "支付", "账单"]
      },
      "bank_package_patterns": ["bank", "cmb", "icbc", "ccb", "boc", "abchina"],
      "sms_packages": ["com.android.mms", "com.google.android.apps.messaging", "com.miui.mms"],
      "per_package": [],
      "default_rule": {
        "exclude_content_contains": []
      }
    },
    "a11y": {
      "embedded_payment_apps": [
        "com.tencent.mm",
        "com.eg.android.AlipayGphone",
        "com.unionpay",
        "cmb.pb",
        "com.icbc",
        "com.chinamworld.bocmbci",
        "com.ccb.longjiLife"
      ],
      "success_keywords": ["支付成功", "付款成功", "转账成功", "收款成功", "交易成功", "支付完成"],
      "embedded_success_keywords": [],
      "common_exclude_keywords": ["余额不足", "支付失败", "交易失败"],
      "wechat_alipay_exclude_keywords": ["群收款", "邀请你", "待确认"],
      "amount_regex": "[¥￥][ \\t\\n\\x0B\\f\\r\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]*(\\d+\\.?\\d{0,2})|(\\d+\\.?\\d{0,2})[ \\t\\n\\x0B\\f\\r\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]*元",
      "cooldown_minutes": 5,
      "list_page_keywords": ["账单", "交易记录", "明细", "全部交易", "收支记录", "历史", "月账单"],
      "list_page_min_amounts": 3
    },
    "sms": {
      "spam_keywords": ["退订", "办理", "开通", "激活", "贷款", "借款", "提额", "申请", "审批", "优惠券"]
    },
    "source_mapping": {
      "com.tencent.mm": "微信",
      "com.eg.android.AlipayGphone": "支付宝",
      "com.android.mms": "短信",
      "com.unionpay": "云闪付",
      "cmb.pb": "招商银行",
      "com.icbc": "工商银行",
      "com.chinamworld.bocmbci": "中国银行",
      "com.ccb.longjiLife": "建设银行"
    },
    "processor": {
      "scoring_window_seconds": 10,
      "dedup_window_seconds": 60,
      "marketing_suffix_cutoffs": ["点击领取"],
      "marketing_comma_keywords": ["红包", "领", "优惠"],
      "max_amount_cents": 10000000,
      "min_amount_cents": 1
    }
  }
}
